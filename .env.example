# ============================================================
#  NEXO · credenciais de envio de e-mail  (LADO DO SERVIDOR)
#  NUNCA copie estes valores para js/*.js, index.html ou CSS.
#  Copie este arquivo para `.env` (local) e preencha.
#  `.env` está no .gitignore e não é publicado.
# ============================================================

# --- produção (api/send-email.js na Vercel) -----------------
# Variáveis que você cria em: Vercel → Project → Settings →
# Environment Variables. Em ambiente local, preencha o .env.

# Provedor: resend (padrão) ou brevo
EMAIL_PROVIDER=resend

# Chave PRIVADA do provedor (https://resend.com/api-keys)
# Ex.: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_PROVIDER_API_KEY=

# Remetente verificado no domínio do provedor.
# Para testar no Gmail: use um domínio verificado; sem domínio
# próprio, a Resend só envia para o próprio dono da conta.
# Ex.: codigo@seudominio.com   (só o endereço — o nome exibido
#      vem de EMAIL_FROM_NAME)
EMAIL_FROM=codigo@seudominio.com

# Nome exibido no cabeçalho "De:" do e-mail.
# Autenticado no domínio acima; nunca um endereço genérico.
EMAIL_FROM_NAME=Segurança da Nexo

# Opcional: para responder
EMAIL_REPLY_TO=

# IMPORTANTE — accepted ≠ delivered:
#   accepted = o provedor aceitou o pedido de envio
#   delivered = o e-mail chegou na caixa do usuário
# A interface NUNCA afirma entrega; só o provedor/Gmail sabe.
# Guia completo (SPF, DKIM, DMARC, teste no Gmail): docs/EMAIL.md

# --- desenvolvimento local (serve.ps1) ----------------------
# Usado pelo servidor local quando EMAIL_PROVIDER_API_KEY estiver
# vazio: envio direto por SMTP (Gmail exige senha de aplicativo
# em Conta → Segurança → Verificação em duas etapas).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
