# ============================================================
#  NEXO - variaveis de ambiente (MODELO)
#
#  COPIE para ".env" (desenvolvimento local) e configure no
#  Netlify (producao). NUNCA preencha este arquivo com valores
#  reais: ele e versionado. O ".env" NAO e versionado.
#
#  Onde configurar no Netlify:
#    Netlify > Site configuration > Environment variables
#    (Build & deploy > Environment > Environment variables)
#
#  Nenhuma destas variaveis e lida pelo navegador.
#  Apenas a camada backend (Netlify Functions) as enxerga.
# ============================================================

# URL do projeto Supabase (sem barra no final)
SUPABASE_URL=

# Chave PUBLICA (anon / publishable) - segura no frontend por
# definicao, mas o Nexo nao a usa: toda chamada passa pela Function.
SUPABASE_ANON_KEY=

# Chave de SERVICO (service_role) - SEGREDO.
#   · existe so no ambiente da Function (Netlify) e no .env local;
#   · nunca vai para HTML, JS do navegador, Git, README ou console;
#   · se vazar, gere outra em Supabase > Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Driver de banco do backend:
#   supabase = banco online (producao)
#   sqlite    = arquivo local, sem rede (testes offline)
NEXO_DB=supabase

# Apenas para NEXO_DB=sqlite
# NEXO_SQLITE_FILE=tools/.nexo-local.db
