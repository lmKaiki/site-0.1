# ============================================================
#  NEXO .gitignore  (ASCII puro, sem acentos)
#  NUNCA versionar credenciais / segredos
# ============================================================

# --- credenciais: nunca versionadas ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
credentials.json
service-account*.json
netlify-token
.netlify

# --- chaves de API e tokens (credenciais de verdade) ---
#  (nada generico demais: "tokens.css" e afins sao arquivos de design)
*.token
.token
.token.*
*token.txt
*token.json
*token.yml
*token.yaml
*secret*
*credential*
!css/tokens.css
!css/tokens*.css

# --- dependencias e build ---
node_modules/
.vercel/
*.log

# --- sistema ---
.DS_Store
Thumbs.db
desktop.ini
