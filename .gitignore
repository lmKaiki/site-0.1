# ============================================================
#  NEXO .gitignore  (ASCII puro, sem acentos)
#  NUNCA versionar credenciais / segredos
# ============================================================

# --- credenciais: nunca versionadas ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
credentials.json
service-account*.json
netlify-token
.netlify

# --- chaves de API e tokens (qualquer arquivo com esse nome) ---
*secret*
*token*
!*tokens.css

# --- dependencias e build ---
node_modules/
.vercel/
*.log

# --- sistema ---
.DS_Store
Thumbs.db
desktop.ini
